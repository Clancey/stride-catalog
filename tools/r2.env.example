# R2 configuration for the Stride catalog.
#
#   cp tools/r2.env.example tools/r2.env   &&   edit   &&   source tools/r2.env
#
# tools/r2.env is gitignored. Never commit a token.

# Cloudflare account that owns the bucket.
export R2_ACCOUNT_ID=f02efc83dafc34d0031e95bcf99046aa

# Bucket name (not the dashboard URL).
export R2_BUCKET=stride

# The base URL a treadmill will actually fetch from, with no trailing slash.
#
# Either a custom domain bound to the bucket (recommended), or the bucket's r2.dev
# subdomain. Cloudflare rate-limits r2.dev and documents it as unsuitable for
# production, so it is fine for a bench test and not for machines in the field.
#
#   custom domain:  https://apks.example.com
#   r2.dev:         https://pub-<hash>.r2.dev
#
# Must be https: the client refuses anything else, and a redirect off TLS reads as
# "check failed" rather than as a silent downgrade.
export R2_PUBLIC_BASE=https://pub-REPLACE-ME.r2.dev

# Auth for wrangler. Create at:
#   Cloudflare dashboard -> R2 -> Manage API tokens -> Create -> Object Read & Write,
#   scoped to this one bucket.
# Prefer a bucket-scoped token over an account-wide one: this credential's entire job
# is to write APKs into one bucket.
export CLOUDFLARE_API_TOKEN=REPLACE_ME
